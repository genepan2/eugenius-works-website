{
  "name": "eugenius-works-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run test:unit && npm run test:site",
    "pretest:unit": "node -e \"require('node:fs').mkdirSync('test-results', { recursive: true })\"",
    "test:unit": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/unit.xml --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 tests/unit/",
    "pretest:site": "node -e \"require('node:fs').mkdirSync('test-results', { recursive: true })\"",
    "test:site": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/site.xml tests/site/",
    "docs": "node scripts/gen-api-docs.ts",
    "test:e2e": "node tests/e2e/contact.e2e.ts",
    "lint": "eslint .",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "duplicates": "jscpd",
    "size:files": "node scripts/check-file-size.ts",
    "size:bundle": "node scripts/check-bundle-size.ts",
    "todos": "node scripts/check-todos.ts",
    "secrets": "secretlint \"**/*\"",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jost": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "secretlint": "13.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "wrangler": "4.157.0"
  }
}
