# Environment bindings for the /api/contact Worker route.
#
# Copy this file to `.dev.vars` for local `wrangler dev`. `.dev.vars` holds a
# real API key, is gitignored, and must never be committed. In production these
# three are set on the Worker instead, under
# Settings > Variables and Secrets (RESEND_API_KEY as a Secret).

# Resend API key. Create it at https://resend.com/api-keys
RESEND_API_KEY="re_replace_with_your_resend_api_key"

# Sender address. Must be on a domain verified in Resend.
CONTACT_FROM="Eugenious Works <contact@eugenius-works.com>"

# Where contact form submissions are delivered.
CONTACT_TO="info@eugenius-works.com"
