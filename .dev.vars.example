# Environment bindings for the /api/contact Pages Function.
#
# Copy this file to `.dev.vars` for local `wrangler pages dev`. `.dev.vars` holds
# a real API key, is gitignored, and must never be committed. In production these
# three are set in the Cloudflare Pages dashboard instead, under
# Settings > Environment variables.

# Resend API key. Create it at https://resend.com/api-keys
RESEND_API_KEY="re_replace_with_your_resend_api_key"

# Sender address. Must be on a domain verified in Resend.
CONTACT_FROM="Eugenious Works <contact@eugenius-works.com>"

# Where contact form submissions are delivered.
CONTACT_TO="info@eugenius-works.com"
