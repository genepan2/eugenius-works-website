{
  "name": "eugenius-works-website",
  // The Node version of .nvmrc and CI.
  "image": "node:26-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "node",
  "forwardPorts": [4321, 8787],
  "portsAttributes": {
    "4321": { "label": "astro dev" },
    "8787": { "label": "wrangler dev" }
  },
  "postCreateCommand": "npm ci && npm run build",
  "customizations": {
    "vscode": {
      "extensions": ["astro-build.astro-vscode", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
