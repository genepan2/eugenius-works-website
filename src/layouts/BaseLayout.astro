---
import '../styles/global.css';
import jostLatin from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import dotTravel from '../scripts/dot-travel.js?url';
import {
  SITE_NAME,
  SITE_DESCRIPTION,
  AUTHOR,
  ENTITY,
  NAV_LINKS,
  FOOTER_SITE_LINKS,
  FOOTER_LEGAL_LINKS,
  CLOUDFLARE_ANALYTICS_TOKEN,
} from '../consts';
import { getPublishedPosts } from '../content';

interface Props {
  title?: string;
  description?: string;
  /** Fine print at the right of the running head, such as `Nº 004 / 011` or a date. */
  folio?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  /** Path of the social card, relative to the site root. */
  image?: string;
  jsonLd?: object | object[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  folio,
  noindex = false,
  ogType = 'website',
  publishedTime,
  image = '/og.png',
  jsonLd,
} = Astro.props;
const hasPosts = (await getPublishedPosts()).length > 0;
const imageUrl = new URL(image, Astro.site).href;
const imageAlt = 'Eugenius Works: a row of black dots and the line "When something is missing, I build it myself."';
const pageTitle = title ? `${title} — ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const analyticsEnabled =
  import.meta.env.PROD && CLOUDFLARE_ANALYTICS_TOKEN !== 'REPLACE_WITH_CLOUDFLARE_ANALYTICS_TOKEN';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    {hasPosts && <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={jostLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline src={dotTravel}></script>

    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    {
      jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    }

    {
      analyticsEnabled && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${CLOUDFLARE_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </head>
  <body class="bg-paper text-ink font-sans antialiased">
    <a href="#content" class="skip-link fine">Skip to content</a>
    <div class="page flex min-h-screen flex-col">
      <header class="running-head">
        {/*
          The two words are the wordmark. A small gap and no separator keeps
          them reading as "Eugenius Works" rather than as a menu.
        */}
        <nav class="wordmark" aria-label="Primary">
          {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
        {folio && <p class="fine">{folio}</p>}
      </header>

      <main id="content" class="flex-1">
        <slot />
      </main>

      <footer class="colophon fine">
        <nav aria-label="Footer">
          <ul>
            {
              FOOTER_SITE_LINKS.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
          <ul>
            {
              FOOTER_LEGAL_LINKS.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="mt-3">© {new Date().getFullYear()} {ENTITY}</p>
      </footer>
    </div>
  </body>
</html>
