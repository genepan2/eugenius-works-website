---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { workLd } from '../../jsonld';
import { getSortedProjects, metaDescription } from '../../content';

// Every work gets its own page. The markdown body is optional: it continues
// the description when it holds more than comments and whitespace.
export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getSortedProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects.at(i - 1)!,
      next: projects[(i + 1) % projects.length],
    },
  }));
};

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const hasBody = (project.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;
---

<BaseLayout
  title={data.title}
  description={metaDescription(data.description)}
  jsonLd={workLd(data.title, data.description, new URL(Astro.url.pathname, Astro.site).href, data.url)}
>
  <article>
    <header class="page-head">
      <h1 class="word word-long">{data.title}</h1>
      <p class="fine">{data.status}</p>
    </header>

    <div class="reading copy mt-8">
      {
        data.cover && (
          <Image src={data.cover} alt={data.title} class="cover mb-6" widths={[640, 1280, 1920]}
          sizes="(min-width: 40rem) 576px, 100vw" loading="eager" />
        )
      }
      <p>{data.description}</p>
      {hasBody && <div class="prose"><Content /></div>}
    </div>

    <div class="work-meta fine">
      <p>
        {
          data.url && (
            <>
              <a href={data.url} rel="noopener" aria-label={`${data.title} website`}>
                Website
              </a>
              {', '}
            </>
          )
        }
        {
          data.repo && (
            <>
              <a href={data.repo} rel="noopener" aria-label={`${data.title} repository`}>
                Repository
              </a>
              {', '}
            </>
          )
        }
        <a href={`/contact/?re=${encodeURIComponent(data.title)}`}>Send a note</a>
      </p>
    </div>
  </article>

  <nav class="pager fine" aria-label="More works">
    <a href={`/works/${prev.id}/`} class="pager-prev" rel="prev">
      Previous: {prev.data.title}
    </a>
    <a href="/works/" class="pager-all">All works</a>
    <a href={`/works/${next.id}/`} class="pager-next" rel="next">
      Next: {next.data.title}
    </a>
  </nav>
</BaseLayout>
