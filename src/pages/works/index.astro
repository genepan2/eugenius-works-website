---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getSortedProjects } from '../../content';

const projects = await getSortedProjects();
---

<BaseLayout title="Works" description="Products, tools and experiments by Eugen Panov.">
  <h1 class="headline">Works.</h1>
  <p class="fine mt-4 text-center">{projects.length} works, from idea to live.</p>
  <div class="mt-10">
    <ProjectList projects={projects} level="h2" named />
  </div>
</BaseLayout>
