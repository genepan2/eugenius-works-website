---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../content';
import { postLd } from '../../jsonld';
import { readingTime } from '../../reading-time';

// Drafts are excluded here too, so they get no page in the build output.
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);
const date = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' }).format(post.data.date);
const minutes = readingTime(post.body ?? '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const url = encodeURIComponent(canonical);
const text = encodeURIComponent(post.data.title);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.date}
  jsonLd={postLd(post.data.title, post.data.date, canonical)}
>
  <article>
    <header class="page-head">
      <h1 class="title">{post.data.title}</h1>
      <p class="fine">
        <time datetime={post.data.date.toISOString()}>{date}</time>
        {post.data.tags.length > 0 && <span>, {post.data.tags.join(', ')}</span>}
        <span>, {minutes} min read</span>
      </p>
    </header>

    {
      post.data.cover && (
        <Image
          src={post.data.cover}
          alt=""
          class="cover mt-8 max-w-[36rem]"
          widths={[640, 1280, 1920]}
          sizes="(min-width: 40rem) 576px, 100vw"
          loading="eager"
        />
      )
    }

    <div class="reading prose copy mt-10">
      <Content />
    </div>
  </article>

  <p class="share fine mt-12">
    {'Share: '}
    <a href={`https://x.com/intent/post?url=${url}&text=${text}`} rel="noopener noreferrer">X</a>{', '}
    <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${url}`} rel="noopener noreferrer">LinkedIn</a>{', '}
    <a href={`mailto:?subject=${text}&body=${url}`}>Email</a>
  </p>

  <p class="fine mt-12">
    <a href="/blog/" class="inline-flex min-h-9 items-center">All posts</a>
  </p>
</BaseLayout>
