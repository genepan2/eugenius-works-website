---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../content';

// Drafts are excluded here too, so they get no page in the build output.
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);
const dateFormat = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <h1 class="text-3xl font-semibold">{post.data.title}</h1>
    <p class="mt-3 text-sm text-neutral-600">
      <time datetime={post.data.date.toISOString()}>{dateFormat.format(post.data.date)}</time>
      {post.data.tags.length > 0 && <span> · {post.data.tags.join(', ')}</span>}
    </p>

    <div class="prose mt-10">
      <Content />
    </div>
  </article>

  <p class="mt-12">
    <a href="/blog" class="underline hover:no-underline">All posts</a>
  </p>
</BaseLayout>
