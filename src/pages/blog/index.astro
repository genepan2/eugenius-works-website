---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../content';

const posts = await getPublishedPosts();
const dateFormat = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<BaseLayout
  title="Blog"
  description="Articles about design, development, artificial intelligence, entrepreneurship, and business."
>
  <h1 class="text-3xl font-semibold">Blog</h1>
  <p class="mt-4 leading-relaxed">
    Design, development, artificial intelligence, entrepreneurship, and business. Newest
    first.
  </p>

  <ul class="mt-12 divide-y divide-neutral-300">
    {
      posts.map((post) => (
        <li class="py-8 first:pt-0">
          <h2 class="text-lg font-medium">
            <a href={`/blog/${post.id}`} class="underline hover:no-underline">
              {post.data.title}
            </a>
          </h2>
          <p class="mt-1 text-sm text-neutral-600">
            <time datetime={post.data.date.toISOString()}>
              {dateFormat.format(post.data.date)}
            </time>
            {post.data.tags.length > 0 && <span> · {post.data.tags.join(', ')}</span>}
          </p>
          <p class="mt-2 leading-relaxed">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
