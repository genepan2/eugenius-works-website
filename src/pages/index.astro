---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedProjects, hasDetailPage, getPublishedPosts } from '../content';

const projects = await getSortedProjects();
const posts = (await getPublishedPosts()).slice(0, 5);
const dateFormat = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<BaseLayout>
  <section>
    {/* The header wordmark shows the name; this gives the page its top heading. */}
    <h1 class="sr-only">Eugenius Works</h1>
    <p class="text-lg leading-relaxed">
      I am Eugen Panov. I build software and write about design, development, artificial
      intelligence, entrepreneurship, and business.
    </p>
  </section>

  {/* The two halves of the company name, and the two header links. */}
  <section id="eugenius" class="mt-16 scroll-mt-8">
    <h2 class="text-xl font-semibold">Eugenius</h2>
    {/*
      Facts only, for now. The owner will replace this with a fuller text in
      his own words.
    */}
    <p class="mt-6 leading-relaxed">
      Eugenius Works is my company, registered in Estonia. Everything I build runs under it:
      my own products, smaller tools, and my freelance service,
      <a href="https://geteugenius.com" class="underline hover:no-underline">Get Eugenius</a>.
    </p>
  </section>

  <section id="works" class="mt-16 scroll-mt-8">
    <h2 class="text-xl font-semibold">Works</h2>
    <ul class="mt-6 space-y-8">
      {
        projects.map((project) => (
          <li>
            <h3 class="font-medium">
              {hasDetailPage(project) ? (
                <a href={`/projects/${project.id}`} class="underline hover:no-underline">
                  {project.data.title}
                </a>
              ) : (
                project.data.title
              )}
              <span class="text-sm font-normal text-neutral-600"> · {project.data.status}</span>
            </h3>
            {project.data.cover && (
              <Image
                src={project.data.cover}
                alt={project.data.title}
                class="mt-3 max-w-full"
                widths={[400, 800]}
              />
            )}
            <p class="mt-1 leading-relaxed">{project.data.description}</p>
            <p class="mt-1 text-sm text-neutral-600">
              {project.data.url && (
                <a href={project.data.url} class="underline hover:no-underline">
                  Website
                </a>
              )}
              {project.data.url && project.data.repo && <span> · </span>}
              {project.data.repo && (
                <a href={project.data.repo} class="underline hover:no-underline">
                  Repository
                </a>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  {posts.length > 0 && (
  <section class="mt-16">
    <h2 class="text-xl font-semibold">Writing</h2>
    <ul class="mt-6 space-y-8">
      {
        posts.map((post) => (
          <li>
            <h3 class="font-medium">
              <a href={`/blog/${post.id}`} class="underline hover:no-underline">
                {post.data.title}
              </a>
            </h3>
            <p class="mt-1 text-sm text-neutral-600">
              <time datetime={post.data.date.toISOString()}>
                {dateFormat.format(post.data.date)}
              </time>
              {post.data.tags.length > 0 && <span> · {post.data.tags.join(', ')}</span>}
            </p>
            <p class="mt-1 leading-relaxed">{post.data.description}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-8">
      <a href="/blog" class="underline hover:no-underline">All posts</a>
    </p>
  </section>
  )}

  <section class="mt-16">
    <h2 id="contact" class="text-xl font-semibold">Contact</h2>
    <p class="mt-4 leading-relaxed">
      Send a note. Your message is delivered to me by email — see the <a
        href="/privacy"
        class="underline hover:no-underline">privacy policy</a
      > for what happens to it.
    </p>

    <p id="contact-error" class="mt-6 hidden border border-black px-3 py-2" role="alert"></p>

    {/*
      Both notices are hidden until needed. With JavaScript, the script below
      shows them. Without it, /api/contact redirects to #contact-sent or
      #contact-failed, and the :target rule in global.css shows the notice.
    */}
    <p
      id="contact-sent"
      class="target-notice mt-6 leading-relaxed"
      role="status"
      tabindex="-1"
    >
      Thank you — your message is on its way. I will reply to the address you gave.
    </p>

    <p id="contact-failed" class="target-notice mt-6 border border-black px-3 py-2">
      Your message could not be sent. Please check the fields and try again.
    </p>

    <form id="contact-form" class="mt-6 space-y-5" method="post" action="/api/contact">
      <div>
        <label for="name" class="block text-sm">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          class="mt-1 w-full border border-neutral-500 px-3 py-2 focus:border-black focus:outline-none"
        />
      </div>

      <div>
        <label for="email" class="block text-sm">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="mt-1 w-full border border-neutral-500 px-3 py-2 focus:border-black focus:outline-none"
        />
      </div>

      <div>
        <label for="message" class="block text-sm">Message</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          maxlength="5000"
          class="mt-1 w-full border border-neutral-500 px-3 py-2 focus:border-black focus:outline-none"
        ></textarea>
      </div>

      {/*
        Honeypot. Hidden from sighted visitors and from screen readers, and kept
        out of the tab order. Only bots fill it in; /api/contact drops those.
      */}
      <div class="hidden" aria-hidden="true">
        <label for="company">Company</label>
        <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button
        id="contact-submit"
        type="submit"
        class="border border-black px-4 py-2 hover:bg-black hover:text-white disabled:opacity-50"
      >
        Send
      </button>
    </form>

    <script>
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const button = document.getElementById('contact-submit') as HTMLButtonElement | null;
      const errorBox = document.getElementById('contact-error');
      const successBox = document.getElementById('contact-sent');

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!button || !errorBox || !successBox) return;

        errorBox.classList.add('hidden');
        button.disabled = true;
        button.textContent = 'Sending…';

        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          const result = await response.json().catch(() => ({}));

          if (response.ok && result.ok) {
            // Replace the form with the thank-you line.
            // Focus moves to the notice, so a screen reader announces it and
            // keyboard focus is not lost with the hidden form.
            form.classList.add('hidden');
            successBox.style.display = 'block';
            successBox.focus();
            return;
          }

          // Keep the entered values so nothing has to be retyped.
          errorBox.textContent = result.error ?? 'The message could not be sent.';
          errorBox.classList.remove('hidden');
        } catch {
          errorBox.textContent = 'The message could not be sent. Please check your connection.';
          errorBox.classList.remove('hidden');
        }

        button.disabled = false;
        button.textContent = 'Send';
      });
    </script>
  </section>
</BaseLayout>
