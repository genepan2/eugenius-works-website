---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectList from '../components/ProjectList.astro';
import PostList from '../components/PostList.astro';
import StatusDot from '../components/StatusDot.astro';
import { person, website } from '../jsonld';
import { getSortedProjects, getPublishedPosts, numberWord, workNumber } from '../content';

const projects = await getSortedProjects();
const posts = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout jsonLd={[person, website]}>
  {/* The two halves of the company name, and the two header links. */}
  <section id="eugenius" class="ad scroll-mt-8">
    <div class="field hero-field">
      <ul class="hero-dots">
        {
          projects.map((project, i) => (
            <li class="flex">
              <a
                href={`/works/${project.id}/`}
                class="hero-dot"
                data-slug={project.id}
                aria-label={`${project.data.title}, ${project.data.status}`}
              >
                <StatusDot status={project.data.status} />
                <span class="hero-dot-caption fine" aria-hidden="true">
                  Nº {workNumber(i)} {project.data.title}, {project.data.status}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="hero-caption fine">
        {numberWord(projects.length)} works. The larger the dot, the closer to finished.
      </p>
    </div>

    <h1 class="headline">When something is missing, I build it myself.</h1>

    <div class="columns copy">
      <p>
        I studied communication design because I was fascinated by good ideas in advertising.
        After that, I spent years freelancing in print and web, and when a project called for
        it, backend too.
      </p>
      <p>
        Today my focus is on automation and AI. When something is missing, I build it myself.
        You'll find some of it here.
      </p>
      <p>
        What interests me in all of this is how problems get solved, in design, technology and
        business. That's what I write about here.
      </p>
    </div>

    <div class="signature-block">
      <p class="signature">Eugenius.</p>
      <p class="fine">Eugen Panov</p>
    </div>
  </section>

  <section id="works" class="mt-24 scroll-mt-8">
    <div class="section-head">
      <h2 class="headline headline-left">Works.</h2>
      <p class="fine">{projects.length} works, from idea to live.</p>
    </div>
    <ProjectList projects={projects} />
  </section>

  {
    posts.length > 0 && (
      <section class="mt-24">
        <div class="section-head">
          <h2 class="headline headline-left">Writing.</h2>
        </div>
        <PostList posts={posts} />
        <p class="fine mt-4">
          <a href="/blog/">All posts</a>
        </p>
      </section>
    )
  }

  <section class="closing mt-24">
    <div>
      <h2 id="contact" class="headline headline-left scroll-mt-8">Send a note.</h2>
      <p class="fine mt-4 max-w-[36rem]">
        Your message is delivered to me by email. The <a href="/privacy/">privacy policy</a> says
        what happens to it.
      </p>
    </div>

    <div class="coupon">
    <p id="contact-error" class="notice hidden" role="alert" tabindex="-1"></p>

    {/*
      The notices are hidden until needed. With JavaScript, the script below
      shows them. Without it, /api/contact redirects to #contact-sent,
      #contact-failed or #contact-busy, and the :target rule in global.css
      shows the notice.
    */}
    <p id="contact-sent" class="target-notice notice" role="status" tabindex="-1">
      Thank you. Your message is on its way. I will reply to the address you gave.
    </p>

    <p id="contact-failed" class="target-notice notice">
      Your message could not be sent. Please check the fields and try again.
    </p>

    <p id="contact-busy" class="target-notice notice">
      The form is not available right now. Please try again in a few minutes.
    </p>

    <form id="contact-form" class="space-y-7" method="post" action="/api/contact">
      <div>
        <label for="name" class="field-label fine">Name</label>
        <input id="name" name="name" type="text" required autocomplete="name" />
      </div>

      <div>
        <label for="email" class="field-label fine">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" />
      </div>

      <div>
        <label for="message" class="field-label fine">Message</label>
        <textarea id="message" name="message" rows="6" required maxlength="5000"></textarea>
      </div>

      {/*
        Honeypot. Hidden from sighted visitors and from screen readers, and kept
        out of the tab order. Only bots fill it in; /api/contact drops those.
      */}
      <div class="hidden" aria-hidden="true">
        <label for="company">Company</label>
        <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button id="contact-submit" type="submit" class="button">Send</button>
    </form>

    <script>
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const button = document.getElementById('contact-submit') as HTMLButtonElement | null;
      const errorBox = document.getElementById('contact-error');
      const successBox = document.getElementById('contact-sent');

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!button || !errorBox || !successBox) return;

        errorBox.classList.add('hidden');
        form.removeAttribute('aria-describedby');
        button.disabled = true;
        button.textContent = 'Sending…';

        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          const result = await response.json().catch(() => ({}));

          if (response.ok && result.ok) {
            // Replace the form with the thank-you line.
            // Focus moves to the notice, so a screen reader announces it and
            // keyboard focus is not lost with the hidden form.
            form.classList.add('hidden');
            successBox.style.display = 'block';
            successBox.focus();
            return;
          }

          // Keep the entered values so nothing has to be retyped.
          errorBox.textContent = result.error ?? 'The message could not be sent.';
          errorBox.classList.remove('hidden');
        } catch {
          errorBox.textContent = 'The message could not be sent. Please check your connection.';
          errorBox.classList.remove('hidden');
        }

        // The button was disabled, so focus fell to the page. Put it on the error.

        form.setAttribute('aria-describedby', 'contact-error');
        button.disabled = false;
        button.textContent = 'Send';
        errorBox.focus();
      });
    </script>
    </div>
  </section>
</BaseLayout>
